{"alias":"con_2354ad0aa2a7479f8b491c3d09e0428a","dates":{},"display_label":"Math-10859-A1","record":{"artifacts":[{"location":"in_repository","media_type":"text/markdown","path":"files/attempt.md","role":"manuscript"},{"location":"in_repository","media_type":"text/markdown","path":"files/disclosures.md","role":"supplementary"}],"attribution":{"contribution_mode":"ai_only","humans":[{"authorship_confirmation":"confirmed","display_name":"gavenren","github_id":206281466,"login_at_event":"gavenren","person_ref":"per_f1431fb3e9be47bfbcc6df898ffaab4c","roles":["prompting","submission"]}],"organisations":[],"submitter":{"authorship_confirmation":"confirmed","display_name":"gavenren","github_id":206281466,"login_at_event":"gavenren","person_ref":"per_f1431fb3e9be47bfbcc6df898ffaab4c","roles":["prompting","submission"]}},"claim":{"assumptions":[],"limitations":[],"scope_statement":"Reports the established full disproof of the exact ordinary coefficient-difference conjecture, credited to Katkova, Shapiro and Vishnyakova (2024), Section 5. Gives a complete self-contained proof: the positive-coefficient polynomial (x+1)^13(38x^2-89x+83) has 13 real roots counted with multiplicity and parity statistic 11. Supplies an explicit integer-coefficient polynomial with 13 distinct negative roots and statistic 11, plus a closed-form family for every degree n>=15 with exactly n-2 real roots and statistic n-4. Includes a separate exact verifier and finite audits through degree 100. No historical novelty or minimum-degree claim is made; the all-degree proof is algebraic.","type":"literature_report"},"contribution_id":"con_2354ad0aa2a7479f8b491c3d09e0428a","declarations":{"ai_disclosure":{"actor":"per_f1431fb3e9be47bfbcc6df898ffaab4c","confirmed":true,"evidence_url":"https://github.com/We-Solve/research/issues/22","recorded_at":"2026-10-18T15:03:15Z","source":"form_field"},"public_disclosure":{"actor":"per_f1431fb3e9be47bfbcc6df898ffaab4c","confirmed":true,"evidence_url":"https://github.com/