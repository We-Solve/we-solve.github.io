{"alias":"ECON-C78-136-A2","dates":{},"display_label":"Econ-139-A2","record":{"artifacts":[{"location":"in_repository","media_type":"application/x-tex","path":"files/divorce_reachability_contribution.tex","role":"manuscript"}],"attribution":{"contribution_mode":"human_ai","humans":[{"authorship_confirmation":"confirmed","display_name":"harisaziz","github_id":29603847,"login_at_event":"harisaziz","person_ref":"per_6b6ae3b3a7574c49b69cf8a228b4bea7","roles":["submission"]}],"organisations":[],"submitter":{"authorship_confirmation":"confirmed","display_name":"harisaziz","github_id":29603847,"login_at_event":"harisaziz","person_ref":"per_6b6ae3b3a7574c49b69cf8a228b4bea7","roles":["submission"]}},"claim":{"assumptions":["Strict, complete preference lists and perfect matchings; divorces pair the deserted partners."],"limitations":["The exact complexity of unrestricted DivorceSM and its membership in NP remain open.","The polynomial path bound is established for the reduction instances, not for all affirmative instances."],"scope_statement":"We prove that deciding whether\na stable matching is reachable by these operations is NP-hard even\nwith strict, complete preferences. This answers the open question of\nwhether divorce reachability remains computationally hard with complete\nlists. Hardness holds although every yes-instance produced by the\nreduction has a successful sequence of linear length. Consequently,\ndeciding whether stability is reachable within three times the number\nof agents on either side is NP-complete.","type":"partial_result"},"contribution_id":"con_0725f37f9da74637b52ac3a922e49db7","declarations":{"ai_disclosure":{"actor":"per_6b6ae3b3a7574c49b69cf8a228b4bea7","confirmed":true,"evidence_url":"https://github.com/We-Solve/research/issues/437","recorded_at":"2026-10-20T02:24:39Z","source":"form_field"},"public_disclosure":{"actor":"per_6b6ae3b3a7574c49b69cf8a228b4bea7","confirmed":true,"evidence_url":"https://github.com/We-Solve/research/issues/437","rec